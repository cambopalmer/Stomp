{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bootstrap-sha": "9d13cb5",
  "packages": {
    ".": {
      "release-type": "node",
      "package-name": "stomp",
      "component": "stomp",
      "include-component-in-tag": false,
      "changelog-path": "CHANGELOG.md",
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": false,
      "draft": false,
      "prerelease": false,
      "extra-files": [
        { "type": "json", "path": "apps/api/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "apps/web/package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "packages/shared/package.json", "jsonpath": "$.version" }
      ]
    }
  },
  "changelog-sections": [
    { "type": "feat", "section": "Features" },
    { "type": "fix", "section": "Bug Fixes" },
    { "type": "perf", "section": "Performance" },
    { "type": "refactor", "section": "Refactoring" },
    { "type": "test", "section": "Tests" },
    { "type": "docs", "section": "Documentation" },
    { "type": "build", "section": "Build & CI" },
    { "type": "ci", "section": "Build & CI", "hidden": true },
    { "type": "chore", "section": "Chores", "hidden": true }
  ]
}
