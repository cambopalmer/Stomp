# --- apps/api ---
API_PORT=3000
# SQLite file (relative to apps/api) or a libSQL/Turso URL later
DATABASE_URL=file:./.data/stomp.db
# CORS origin for the web app in dev
WEB_ORIGIN=http://localhost:5173
# Seeded user the API acts as until real auth (Phase 3). Must match a seeded user's email.
SEED_USER_EMAIL=owner@stomp.local
# Public base URL used to build sitemap.xml absolute links
PUBLIC_BASE_URL=http://localhost:8080

# --- apps/web (Vite, must be prefixed VITE_) ---
VITE_API_BASE_URL=/api
