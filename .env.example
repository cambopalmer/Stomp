# --- apps/api ---
API_PORT=3000
# SQLite file (relative to apps/api) or a libSQL/Turso URL later
DATABASE_URL=file:./.data/stomp.db
# CORS origin for the web app in dev
WEB_ORIGIN=http://localhost:5173
# Seeded owner account. In dev this user is auto-created with password SEED_USER_PASSWORD.
SEED_USER_EMAIL=owner@stomp.local
SEED_USER_PASSWORD=stomp-dev-password
# Public base URL used to build sitemap.xml absolute links
PUBLIC_BASE_URL=http://localhost:8080

# --- observability ---
LOG_LEVEL=info
# off | console | otlp
OTEL_MODE=off
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
SERVICE_NAME=stomp-api

# --- auth (Phase 3) ---
# 64+ random chars — signs the session cookie
SESSION_SECRET=change-me-to-a-long-random-string-please-really
# allow open self-service signup (else invite/admin only)
ALLOW_SIGNUP=true
# Google OAuth — create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {PUBLIC_BASE_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- apps/web (Vite, must be prefixed VITE_) ---
VITE_API_BASE_URL=/api
